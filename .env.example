# Server port (1024-65535)
PORT=3000

# SQLite database path (use :memory: for ephemeral runs)
DB_PATH=./data/cdr-monitor.db

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# HTTP timeout for optional live CDR sync calls (milliseconds)
CDR_TIMEOUT_MS=5000

# Allow live outbound HTTP calls to public CDR endpoints (false keeps runs strictly offline)
ALLOW_LIVE_SYNC=true
