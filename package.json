{
  "name": "cdr-home-loan-monitor",
  "version": "0.1.0",
  "description": "AU Open Banking (CDR) Home Loan Product & Rate Monitor — locally runnable regulated-enterprise vertical slice",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "format": "oxfmt src tests",
    "format:check": "oxfmt --check src tests",
    "test": "vitest run --passWithNoTests",
    "sync:live": "tsx src/cli/sync.ts --live",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.20",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@10.0.0"
}
